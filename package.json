{
  "name": "meeting-notes",
  "version": "0.1.0",
  "description": "Local-first desktop meeting transcription and AI minutes application",
  "author": "zcxads666",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "MEETING_API_TOKEN=dev-local VITE_MEETING_TOKEN=dev-local concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/index.js",
    "postinstall": "echo '[meeting] run: npm run setup:python to install Python deps'",
    "setup:python": "node scripts/python-setup.mjs",
    "setup:runtime-build": "node scripts/python-build-setup.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/system/*.test.js\"",
    "test:python": "node scripts/python-test.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "test:startup": "node scripts/startup-smoke.mjs",
    "dist": "node scripts/build-release.mjs",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k -n web,electron \"npm:dev:web\" \"electron . --dev\"",
    "desktop:dist": "npm run build:runtime && electron-builder"
  },
  "dependencies": {
    "@derhuerst/ffprobe-static": "5.3.0",
    "concurrently": "^9.0.0",
    "express": "^4.19.2",
    "ffmpeg-static": "5.3.0",
    "multer": "^1.4.5-lts.2",
    "openai": "^4.67.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "ws": "^8.18.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.10",
    "vite": "^8.2.1"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.meeting.notes",
    "productName": "MeetingNotes",
    "artifactBuildCompleted": "scripts/artifact-build-completed.cjs",
    "directories": {
      "output": "release/desktop"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "web/dist/**/*",
      "python/main.py",
      "python/model_manager.py",
      "python/transcribe_whisper.py",
      "python/transcribe_qwen.py",
      "python/forced_aligner.py",
      "python/diarization.py",
      "python/streaming_vllm.py",
      "python/runtime.py",
      "python/requirements.txt",
      "python/requirements-diarization.txt",
      "python/requirements-streaming.txt",
      "README.md",
      "docs/**/*",
      "package.json",
      "!node_modules/ffmpeg-static/ffmpeg",
      "!node_modules/ffmpeg-static/ffmpeg.exe",
      "!node_modules/@derhuerst/ffprobe-static/ffprobe",
      "!node_modules/@derhuerst/ffprobe-static/ffprobe.exe"
    ],
    "extraResources": [
      {
        "from": "release/runtime/meeting-runtime",
        "to": "runtime/meeting-runtime"
      },
      {
        "from": "node_modules/ffmpeg-static",
        "to": "tools/ffmpeg",
        "filter": ["ffmpeg", "ffmpeg.exe", "LICENSE"]
      },
      {
        "from": "node_modules/@derhuerst/ffprobe-static",
        "to": "tools/ffprobe",
        "filter": ["ffprobe", "ffprobe.exe", "LICENSE"]
      }
    ],
    "asarUnpack": [
      "python/main.py",
      "python/model_manager.py",
      "python/transcribe_whisper.py",
      "python/transcribe_qwen.py",
      "python/forced_aligner.py",
      "python/diarization.py",
      "python/streaming_vllm.py",
      "python/runtime.py",
      "python/requirements.txt",
      "python/requirements-diarization.txt",
      "python/requirements-streaming.txt"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "notarize": true,
      "binaries": [
        "Contents/Resources/runtime/meeting-runtime/meeting-runtime",
        "Contents/Resources/tools/ffmpeg/ffmpeg",
        "Contents/Resources/tools/ffprobe/ffprobe"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signExts": [
        ".exe",
        ".dll"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "@derhuerst/ffprobe-static@5.3.0": true
  }
}
