{
  "name": "meeting-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "MEETING_API_TOKEN=dev-local VITE_MEETING_TOKEN=dev-local concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/index.js",
    "postinstall": "echo '[meeting] run: npm run setup:python to install Python deps'",
    "setup:python": "python3 -m venv python/.venv && python/.venv/bin/pip install --upgrade pip && python/.venv/bin/pip install -r python/requirements.txt",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/system/*.test.js\"",
    "test:python": "python3 -m unittest discover -s python/tests -p 'test_*.py'",
    "dist": "node scripts/build-release.mjs",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k -n web,electron \"npm:dev:web\" \"electron . --dev\"",
    "desktop:dist": "electron-builder"
  },
  "dependencies": {
    "concurrently": "^9.0.0",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.2",
    "openai": "^4.67.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "ws": "^8.18.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.10",
    "vite": "^8.2.1"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.meeting.notes",
    "productName": "MeetingNotes",
    "directories": {
      "output": "release/desktop"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "web/dist/**/*",
      "python/main.py",
      "python/model_manager.py",
      "python/transcribe_whisper.py",
      "python/transcribe_qwen.py",
      "python/runtime.py",
      "python/requirements.txt",
      "package.json"
    ],
    "asarUnpack": [
      "python/main.py",
      "python/model_manager.py",
      "python/transcribe_whisper.py",
      "python/transcribe_qwen.py",
      "python/runtime.py",
      "python/requirements.txt"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
